# Copie para .env (ignorado pelo Git). Use token Cloudflare com os escopos
# Workers Scripts:Edit, D1:Edit, Workers KV Storage:Edit, R2 Storage:Edit,
# Zone:DNS:Edit, Zone:Zone:Read e Access: Apps and Policies:Read.
CLOUDFLARE_API_TOKEN=preencha-com-um-token-local-nao-commite
CLOUDFLARE_ACCOUNT_ID=preencha-com-o-id-da-conta
CLOUDFLARE_ZONE_ID=preencha-com-o-id-da-zona-brunosrz-com
CLOUDFLARE_ACCESS_ALLOWED_EMAILS=seu-email@exemplo.com
