# A CI de lint/test/build não precisa de secrets Cloudflare. Estes nomes são
# referências para os environments `preview` e `production` no GitHub.
# As variáveis de conta/zone/Access são compartilhadas; tokens de aplicação
# devem ser independentes por ambiente.

# GitHub Environment variables (preview e production; valores atuais no GitHub)
CLOUDFLARE_ACCOUNT_ID=account-id
CLOUDFLARE_ZONE_ID=zone-id
CLOUDFLARE_ACCESS_ALLOWED_EMAILS=bruno@example.com,outro@example.com

# GitHub repository secrets (somente quando os workflows de deploy/release forem ativados)
CLOUDFLARE_DEPLOY_API_TOKEN=crie-um-token-cloudflare-com-escopo-minimo
RELEASE_PLEASE_TOKEN=token-pessoal-com-conteudo-e-pull-requests

# GitHub Environment secrets (preview)
PDV_WRITE_TOKEN=gere-um-segredo-aleatorio
CATALOG_READ_TOKEN=gere-um-segredo-aleatorio
BACKUP_DOWNLOAD_TOKEN=gere-um-segredo-aleatorio
# Token separado para o Workflow da API exportar o D1; não reutilize o token de deploy.
BACKUP_EXPORT_CLOUDFLARE_API_TOKEN=crie-um-token-cloudflare-minimo-para-exportar-d1

# GitHub Environment secrets (production)
PDV_WRITE_TOKEN=gere-um-segredo-independente-de-producao
CATALOG_READ_TOKEN=gere-um-segredo-independente-de-producao
BACKUP_DOWNLOAD_TOKEN=gere-um-segredo-independente-de-producao
# Só cadastrar após provisionar D1 de produção e criar token Cloudflare restrito a ele.
BACKUP_EXPORT_CLOUDFLARE_API_TOKEN=token-cloudflare-minimo-para-exportar-d1-de-producao

# Mapeamento dos secrets de API para `apps/api/.env.<ambiente>`:
# CLOUDFLARE_DEPLOY_API_TOKEN -> CLOUDFLARE_API_TOKEN em .env da raiz
# PDV_WRITE_TOKEN, CATALOG_READ_TOKEN e BACKUP_DOWNLOAD_TOKEN são iguais nos
# dois environments, mas seus valores são exclusivos por ambiente.
# BACKUP_EXPORT_CLOUDFLARE_API_TOKEN -> CLOUDFLARE_API_TOKEN do Worker da API.
