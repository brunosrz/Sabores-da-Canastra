# A CI de lint/test/build não precisa de secrets Cloudflare.
# Estes valores são para um futuro job de deploy no environment `preview`.
# Não use um token amplo da conta como CLOUDFLARE_DEPLOY_API_TOKEN no GitHub.

# GitHub Environment variables (preview)
CLOUDFLARE_ACCOUNT_ID=account-id
CLOUDFLARE_ZONE_ID=zone-id
CLOUDFLARE_ACCESS_ALLOWED_EMAILS=bruno@example.com,outro@example.com

# GitHub Environment secrets (preview)
# Gere um token separado e de escopo mínimo para CI/CD.
CLOUDFLARE_DEPLOY_API_TOKEN=crie-um-token-cloudflare-com-escopo-minimo
PREVIEW_API_PDV_WRITE_TOKEN=gere-um-segredo-aleatorio
PREVIEW_API_CATALOG_READ_TOKEN=gere-um-segredo-aleatorio
PREVIEW_API_BACKUP_DOWNLOAD_TOKEN=gere-um-segredo-aleatorio
# Token separado para o Workflow da API exportar o D1; não reutilize o token de deploy.
PREVIEW_API_CLOUDFLARE_API_TOKEN=crie-um-token-cloudflare-minimo-para-exportar-d1

# Mapeamento do job de deploy para os arquivos que o SCons/Wrangler consomem:
# CLOUDFLARE_DEPLOY_API_TOKEN -> CLOUDFLARE_API_TOKEN em .env da raiz
# PREVIEW_API_* -> mesmos nomes sem PREVIEW_API_ em apps/api/.env.preview

# Produção não está provisionada. Não configure/deploy até criar recursos,
# rotas Access e credenciais de produção independentes.
# CLOUDFLARE_PRODUCTION_ACCOUNT_ID=
# CLOUDFLARE_PRODUCTION_ZONE_ID=
# PRODUCTION_API_PDV_WRITE_TOKEN=
# PRODUCTION_API_CATALOG_READ_TOKEN=
# PRODUCTION_API_BACKUP_DOWNLOAD_TOKEN=
# PRODUCTION_API_CLOUDFLARE_API_TOKEN=
