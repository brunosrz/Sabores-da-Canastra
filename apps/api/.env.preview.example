# Copie para apps/api/.env.preview. O SCons envia estes valores como secrets
# para o Worker API de preview; nunca versionar o arquivo preenchido.
# Segredo JSON com hashes PBKDF2 das contas autorizadas; nunca coloque senhas aqui em texto puro.
AUTH_USERS=[{"id":"user_bruno","username":"bruno","role":"owner","salt":"BASE64URL_SALT","hash":"BASE64URL_HASH","iterations":600000},{"id":"user_ivone","username":"ivone","role":"owner","salt":"BASE64URL_SALT","hash":"BASE64URL_HASH","iterations":600000}]
# Opcional para publicar preview. Necessário para executar backups remotos;
# use um token Cloudflare de escopo mínimo com permissão de exportar o D1.
CLOUDFLARE_API_TOKEN=
