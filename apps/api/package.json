{
  "name": "@sabores/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 3000",
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" scripts/*.mjs eslint.config.js package.json tsconfig.json vitest.config.ts wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types --include-runtime=false",
    "db:migrate:local": "wrangler d1 migrations apply sabores-canastra-shared --local --config wrangler.jsonc",
    "db:import:local": "node scripts/import-local.mjs"
  },
  "dependencies": {
    "hono": "^4.10.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
