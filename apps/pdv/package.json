{
	"name": "@sabores/pdv",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 3002",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 3002",
		"lint": "eslint .",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"test/**/*.ts\" eslint.config.js index.html package.json tsconfig.json tsr.config.json vite.config.ts vitest.config.mts worker-configuration.d.ts wrangler.jsonc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"cf-typegen": "wrangler types --include-runtime=false",
		"mobile:prepare": "vite build && node ../../scripts/prepare-capacitor-assets.mjs pdv",
		"mobile:sync:android": "pnpm mobile:prepare && cap sync android",
		"mobile:sync:ios": "pnpm mobile:prepare && cap sync ios"
	},
	"dependencies": {
		"@capacitor/android": "8.6.0",
		"@capacitor/core": "8.6.0",
		"@capacitor/ios": "8.6.0",
		"@sabores/i18n": "workspace:*",
		"@sabores/pdv-sync": "workspace:*",
		"@sabores/ui": "workspace:*",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "0.10.14",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-query": "5.105.1",
		"@tanstack/react-query-devtools": "5.105.1",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.2",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.4",
		"dexie": "4.4.7",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@capacitor/cli": "8.6.0",
		"@cloudflare/vite-plugin": "^1.26.0",
		"@cloudflare/workers-types": "5.20261101.1",
		"@eslint/js": "^10.0.1",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "0.8.6",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"eslint": "^10.14.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.13.0",
		"prettier": "3.9.10",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.0.0",
		"vitest": "5.0.5",
		"wrangler": "4.156.0"
	}
}
