{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sabores-canastra-pdv",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"observability": { "enabled": true },
	"services": [{ "binding": "API", "service": "sabores-canastra-api-local" }],
	"env": {
		"preview": {
			"name": "sabores-canastra-pdv-preview",
			"services": [{ "binding": "API", "service": "sabores-canastra-api-preview" }],
		},
		"production": {
			"name": "sabores-canastra-pdv",
			"services": [{ "binding": "API", "service": "sabores-canastra-api" }],
		},
	},
}
